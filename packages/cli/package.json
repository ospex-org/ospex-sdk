{
  "name": "@ospex/cli",
  "version": "0.3.0",
  "description": "Command-line interface for the Ospex protocol.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ospex": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "dev": "tsx src/index.ts",
    "test": "yarn workspace @ospex/sdk build && vitest run",
    "test:watch": "vitest",
    "typecheck": "yarn workspace @ospex/sdk build && tsc --noEmit"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.32",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8"
  }
}
