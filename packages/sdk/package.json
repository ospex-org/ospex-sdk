{
  "name": "@ospex/sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for the Ospex protocol — reads, EIP-712 helpers, Realtime odds.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./signers/keystore": {
      "types": "./dist/signers/keystore.d.ts",
      "import": "./dist/signers/keystore.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "ethers": "^6.13.4",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.32",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8"
  }
}
