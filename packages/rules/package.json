{
  "name": "@ospex/rules",
  "version": "0.1.0",
  "description": "Builds and checks the two permissions an Ospex account signs: the top-up rule and the bet rule.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "test": "tsx --test tests/protocol.test.ts tests/delegation.test.ts tests/verifyDelegation.test.ts tests/topUp.test.ts tests/rules.test.ts tests/usdc.test.ts tests/mainnetTopUp.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@metamask/smart-accounts-kit": "2.0.0",
    "viem": "2.55.10"
  },
  "devDependencies": {
    "@types/node": "20.19.39",
    "rimraf": "6.1.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
